<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PrinterRescue.Gui;assembly=PrinterRescue.Gui"
        x:Class="PrinterRescue.Gui.MainWindow"
        Title="Printer Rescue" Width="900" Height="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12"
        x:DataType="vm:MainWindowViewModel">

    <!-- Top bar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button Content="Diagnose" Command="{Binding DiagnoseCommand}" />
      <Button Content="Create snapshot" Command="{Binding CreateSnapshotCommand}" />
    </StackPanel>

    <!-- Content: list on the left, results on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,3*">
      <ListBox Grid.Column="0" ItemsSource="{Binding Printers}"
               SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PrinterItem">
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Padding="8">
        <ListBox ItemsSource="{Binding Results}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Detail}" Margin="2" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="8,4" CornerRadius="4" Background="#22808080">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
