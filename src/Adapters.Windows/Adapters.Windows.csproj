<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PrinterRescue.Adapters.Windows</RootNamespace>
    <AssemblyName>PrinterRescue.Adapters.Windows</AssemblyName>
    <!-- Pure net8.0: compiles on Linux. Any code touching the Windows API uses
         [SupportedOSPlatform("windows")] + an OperatingSystem.IsWindows() guard;
         CA1416 is an error (TreatWarningsAsErrors), so nothing passes without a guard. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
